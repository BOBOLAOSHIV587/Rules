[Script]
# > 📺 哔哩哔哩皮肤
📺 哔哩哔哩皮肤 = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?, requires-body=1, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/Bilibili/JS/JS-3/BiliBili.Modified.response.js, argument=
📺 哔哩哔哩皮肤 = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/(account\/(myinfo|mine)|space)([\/?]|$), requires-body=1, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/Bilibili/JS/JS-3/BiliBili.Modified.response.js, argument=
📺 哔哩哔哩皮肤 = type=http-response, pattern=^https:\/\/api\.bilibili\.com\/x\/vip\/(web\/vip_center\/combine|price\/panel\/lexi|top_panel_info), requires-body=1, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/Bilibili/JS/JS-3/BiliBili.Modified.response.js, argument=

[MITM]
hostname = %APPEND% app.bilibili.com, api.bilibili.com
h2 = true
