#!name=Pixiv · 全局增强翻译
#!desc=全页面日文深度汉化 · AI 视觉多模态漫翻 · 内置设置中心。\n• 出版级双语小说阅读：原文在上一一对应，渐进式渲染与失败重试\n• 统一 Apple SF Symbols 单色矢量图标系统与 Grouped 规范设计\n• 悬浮按钮纯粹总开关控制，自动避开原生控件且滚动不跳跃\n• 真实可管理本地缓存统计（字节级大小、条目数、最近时间、清理反馈）\n• 首页/榜单/详情/评论/画师主页全量汉化，彻底消除查看更多弹窗\n• 内置 2500+ 高频 Pixiv Tag 离线字典，0ms 极速秒翻且副标题自动净空。
#!date=2026-10-13
#!category=🐹 BOBO Enhance
#!author=TomCatXue[https://github.com/TomCatXue/MyCookieCenter]
#!icon=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Icons/AppIcons/Image/App/Pixiv.png
#!openUrl=https://apps.apple.com/app/id337248563

[Rewrite]
# 1. 劫持 Pixiv App 内「帮助中心」与「服务条款」，一键直达增强设置中心
^https?:\/\/app\.pixiv\.help(?:\/.*)?$ 302 https://app-api.pixiv.net/settings/Enhanced
^https?:\/\/policies\.pixiv\.net(?:\/.*)?$ 302 https://app-api.pixiv.net/settings/Enhanced

[Script]
# 设置中心页面 + 漫画查看器 (GET 请求，脚本内联直出 HTML，0ms 离线瞬时秒开)
http-request ^https:\/\/(app-api|www)\.pixiv\.net\/(settings\/Enhanced|manga\/viewer) requires-body=false, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/JS-1/Pixiv/JS/PixivEnhanced/PixivEnhanced.js, tag=Pixiv.Enhanced.SettingsAPI

# 设置中心 API 存取与测速 (POST 请求，需读取请求体)
http-request ^https:\/\/(app-api|www)\.pixiv\.net\/api\/ requires-body=true, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/JS-1/Pixiv/JS/PixivEnhanced/PixivEnhanced.js, tag=Pixiv.Enhanced.SettingsAPI

# 全页面 REST API 响应体汉化拦截器（全覆盖首页home/推荐/榜单/详情/评论v3/画师主页/特辑/漫画/小说/冷启动流）
http-response ^https:\/\/app-api\.pixiv\.net\/v[1-3]\/(illust|manga|novel|user|search|trending-tags|spotlight|home|walkthrough) requires-body=1, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/JS-1/Pixiv/JS/PixivEnhanced/PixivEnhanced.js, tag=Pixiv.Enhanced.ApiTranslate

# 小说阅读器 & 页面注入 iOS SF Symbols「文/A」悬浮按钮与排版引擎
http-response ^https:\/\/app-api\.pixiv\.net\/webview\/v2\/novel requires-body=1, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/JS-1/Pixiv/JS/PixivEnhanced/PixivEnhanced.js, tag=Pixiv.Enhanced.WebviewInject

# 翻译中转网关与 AI 视觉漫翻端点
http-request ^https:\/\/(app-api|www)\.pixiv\.net\/pxtrans requires-body=1, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/JS-1/Pixiv/JS/PixivEnhanced/PixivEnhanced.js, tag=Pixiv.Enhanced.Proxy

[MITM]
hostname = app-api.pixiv.net, app.pixiv.help, policies.pixiv.net, www.pixiv.net
