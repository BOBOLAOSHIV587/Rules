#!name =  iRingo: 📰 News
#!desc = 1.自定义解锁News的地区\n2.Coming Soon…
#!date = 2026-07-30
#!category =  iRingo
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://NSRingo.github.io/guide/apple-news
#!icon = https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Icons/AppIcons/Image/IMG/iRingo/News.png
#!openUrl = http://boxjs.com/#/app/iRingo.News

[Argument]
CountryCode = select,"US","AUTO","CN","HK","TW","SG","JP","AU","GB","KR","CA","IE",tag=国家或地区代码,desc=不同国家或地区提供的内容或有差别。
NewsPlusUser = switch,true,tag=[搜索]显示News+内容,desc=是否显示News+搜索结果。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rule]
# > iCloud
DOMAIN,gateway.icloud.com,PROXY

# > News
DOMAIN,news-edge.apple.com,PROXY
DOMAIN,news-events.apple.com,PROXY
DOMAIN,apple.comscoreresearch.com,PROXY
# News+ Audio
URL-REGEX,^https?:\/\/news-assets\.apple\.com\/(audio-narrative|podcast\/audio)\/.*,PROXY

[Script]
http-request ^https?:\/\/news(-todayconfig)?-edge\.apple\.com\/v1\/configs script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/iRingo/News/JS/request.bundle.js, requires-body=1, tag=📰 News.v1.configs.request, argument=[{CountryCode},{NewsPlusUser},{LogLevel}]
http-request ^https?:\/\/news(-sports)?-events\.apple\.com\/analyticseventsv2\/async script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/iRingo/News/JS/request.bundle.js, requires-body=1, tag=📰 News.analyticseventsv2.async.request, argument=[{CountryCode},{NewsPlusUser},{LogLevel}]
http-request ^https?:\/\/news-client-search\.apple\.com\/v1\/search script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/iRingo/News/JS/request.bundle.js, tag=📰 News.v1.search.request, argument=[{CountryCode},{NewsPlusUser},{LogLevel}]

[MITM]
hostname = news-edge.apple.com, news-todayconfig-edge.apple.com, news-events.apple.com, news-sports-events.apple.com, news-client.apple.com, news-client-search.apple.com
