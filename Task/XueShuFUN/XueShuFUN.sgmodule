#!name=学术FUN-AI工具整合包 自动签到
#!desc=自动获取 xueshu.fun 的 Cookie/UA 并每日自动签到
#!date=2026-08-19
#!category=🐹 BOBO Task
#!author= BOBOLAOSHIV587[https://github.com/BOBOLAOSHIV587/Rules],Claude[https://claude.ai/]
#!icon=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Icons/AppIcons/Image/App/XueShuFUN.png
#!openUrl=https://xueshu.fun/
#!arguments=禁用脚本:学术FUN获取Cookie,禁用MITM:hostname
#!arguments-desc=禁用脚本：禁用获取Cookie脚本，输入 # 表示禁用.\n禁用MITM：禁用MITM主机名，默认 hostname 表示启用，输入 # 表示禁用。\n\n此脚本获取Cookie会多次触发，导致Surge崩溃设备发热。获取一次Cookie后关闭即可。

[Script]
# > 学术FUN获取Cookie
{{{禁用脚本}}} = type=http-request,pattern=^https:\/\/xueshu\.fun\/wp-admin\/admin-ajax\.php,requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/XueShuFUN/JS/Get-Cookie.js, timeout=15

# > 学术FUN签到
学术FUN签到 = type=cron,cronexp=10 8 * * *,script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/XueShuFUN/JS/CheckIn.js,wake-system=1,timeout=60

[MITM]
{{{禁用MITM}}} = %APPEND% xueshu.fun
