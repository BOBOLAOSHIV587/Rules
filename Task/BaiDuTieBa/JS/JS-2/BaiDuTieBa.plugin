#!name=贴吧签到
#!desc=自动签到贴吧。\n获取Cookie说明：打开百度贴吧App后, 如通知成功获取cookie, 则可以使用此签到脚本。\n此脚本获取Cookie会多次触发，导致Loon崩溃设备发热。获取一次Cookie后关闭脚本即可。
#!date=2026-08-14
#!category=🐹 BOBO Task
#!author= ClydeTime[https://github.com/ClydeTime/Quantumult]
#!icon=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Icons/miniColor/Image/Color/tieba.png

[Argument]
获取Cookie = switch, ture, tag = [启用]获取Cookie, desc = 关闭开关将不对此选项生效

[Script]
# > 百度贴吧 cookie
http-request ^https?:\/\/tiebac\.baidu\.com\/c\/u\/follow\/getFoldedMessageUserInfo script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/BaiDuTieBa/JS/JS-2/BaiDuTieBa.js, tag=贴吧Cookie1, enable={获取Cookie}
http-request ^https?:\/\/c\.tieba\.baidu\.com\/c\/u\/follow\/getFoldedMessageUserInfo script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/BaiDuTieBa/JS/JS-2/BaiDuTieBa.js, tag=贴吧Cookie2, enable={获取Cookie}

# > 百度贴吧签到
cron "10,20,30 9 * * *" script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/BaiDuTieBa/JS/JS-2/BaiDuTieBa.js, tag=贴吧签到

[MITM]
hostname = tiebac.baidu.com, c.tieba.baidu.com
