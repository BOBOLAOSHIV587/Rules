#!name=贴吧签到
#!desc=自动签到贴吧。
#!date=2026-08-14
#!category=🐹 BOBO Task
#!author= NobyDa[https://github.com/NobyDa/Script]
#!icon=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Icons/miniColor/Image/Color/tieba.png
#!openUrl=https://apps.apple.com/app/id477927812
#!arguments=禁用MITM:hostname
#!arguments-desc=禁用MITM：禁用MITM主机名，默认 hostname 表示启用，输入 # 表示禁用。\n\n打开百度贴吧APP点击"我的"即可获取cookie.\n\n此脚本获取Cookie会多次触发，导致Surge崩溃设备发热。获取一次Cookie后关闭MITM即可。

[Script]
# > 百度贴吧 cookie
贴吧Cookie = type=http-request,pattern=^https?:\/\/(c\.tieba|tiebac)\.baidu\.com\/c\/s\/login,script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/BaiDuTieBa/JS/JS-1/BaiDuTieBa.js,requires-body=0

# > 贴吧签到
贴吧签到 = type=cron,cronexp=10-12 9 * * *,script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/BaiDuTieBa/JS/JS-1/BaiDuTieBa.js,wake-system=1,timeout=15,script-update-interval=0

[MITM]
{{{禁用MITM}}} = %APPEND% tiebac.baidu.com, c.tieba.baidu.com
