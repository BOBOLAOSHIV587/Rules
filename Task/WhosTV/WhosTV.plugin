#!name=WhosTV 自动签到
#!desc=自动抓取 whos.tv Cookie，每日签到，并通过客户端本地通知结果。
#!date=2026-08-01
#!category=🐹 BOBO Task
#!author=imzwr214[https://github.com/imzwr214/whos]
#!icon=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/WhosTV/JS/IMG/WhosTV.png
#!openUrl=https://whos.tv/

[Argument]
cron = input,"30 8 * * *",tag=签到执行时间,desc=默认每天 08:30 执行，格式如 30 8 * * *
ENABLE_CAPTURE = switch,true,tag=开启 Cookie 抓取,desc=true：访问 whos.tv 时自动抓取 Cookie；抓到后建议关闭。false：关闭抓取
WHOSTV_COOKIE = input,"xxx",tag=WhosTV Cookie,desc=可保持 xxx；自动抓取失败时，可手动填写完整 Cookie

[Script]
# > WhosTV 自动签到
http-request ^https?:\/\/(www\.)?whos\.tv\/ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/WhosTV/JS/JS-1/WhosTV.js,timeout=60,tag=WhosTV Cookie 抓取,enable={ENABLE_CAPTURE},argument=[{ENABLE_CAPTURE}]

cron {cron} script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/WhosTV/JS/JS-1/WhosTV.js,timeout=60,tag=WhosTV 自动签到,argument=[{WHOSTV_COOKIE}]

[MITM]
hostname = whos.tv, www.whos.tv
