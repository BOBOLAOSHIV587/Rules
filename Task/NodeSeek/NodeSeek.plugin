#!name=NodeSeek 每日签到
#!desc=用 Safari 打开 nodeseek.com → 停留片刻.\n收到 ✅ NodeSeek Cookie 获取成功 通知即抓取成功
#!date=2026-08-01
#!category=🐹 BOBO Task
#!author=MaYIHEI[https://github.com/MaYIHEI/paperclip]
#!icon=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/NodeSeek/JS/IMG/NodeSeek.png
#!openUrl=https://www.nodeseek.com/

[Argument]
获取Cookie = switch, ture, tag = [启用]获取Cookie, desc = 关闭开关将不对此选项生效

[Script]
# > NodeSeek 每日签到
http-request ^https://www\.nodeseek\.com/, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/NodeSeek/JS/NodeSeek.Cookie.js, requires-body=false,tag=NodeSeek获取Cookie, enable={获取Cookie}

cron "0 8 * * *" script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/NodeSeek/JS/NodeSeek.js, enable=true, tag=NodeSeek签到

[MITM]
hostname = www.nodeseek.com
