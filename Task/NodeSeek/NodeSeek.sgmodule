#!name=NodeSeek 每日签到
#!desc=用 Safari 打开 nodeseek.com → 停留片刻.\n收到 ✅ NodeSeek Cookie 获取成功 通知即抓取成功
#!date=2026-08-01
#!category=🐹 BOBO Task
#!author=MaYIHEI[https://github.com/MaYIHEI/paperclip]
#!icon=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/NodeSeek/JS/IMG/NodeSeek.png
#!openUrl=https://www.nodeseek.com/
#!arguments=禁用MITM:hostname
#!arguments-desc=禁用MITM：禁用MITM主机名，默认 hostname 表示启用，输入 # 表示禁用。\n\n此脚本获取Cookie会多次触发，导致Surge崩溃设备发热。获取一次Cookie后关闭MITM即可。

[Script]
# > NodeSeek 每日签到
NodeSeek获取Cookie = type=http-request,pattern=^https://www\.nodeseek\.com/,requires-body=false,max-size=0,script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/NodeSeek/JS/NodeSeek.Cookie.js

NodeSeek签到 = type=cron,cronexp=0 8 * * *,timeout=60,script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Task/NodeSeek/JS/NodeSeek.js

[MITM]
{{{禁用MITM}}} = %APPEND% www.nodeseek.com
