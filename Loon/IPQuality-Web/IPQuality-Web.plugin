http-request ^http:\/\/paperclip\.test\/ipquality\/api\/bgppath(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Loon/IPQuality-Web/JS/IPQuality-Web-Module.js, tag=IP 检测接口 · BGP 路径, timeout=65, requires-body=false, argument="bgppath", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/speed(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Loon/IPQuality-Web/JS/IPQuality-Speed.js, tag=IP 检测接口 · 节点 HTTPS 轻量测速, timeout=20, requires-body=false, enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/inbound(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Loon/IPQuality-Web/JS/IPQuality-Web-Module.js, tag=IP 检测接口 · 入站路径, timeout=65, requires-body=false, argument="inbound", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/ping(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Loon/IPQuality-Web/JS/IPQuality-Web-Module.js, tag=IP 检测接口 · 三网探针延迟, timeout=65, requires-body=false, argument="ping", enable=true
