http-request ^http:\/\/paperclip\.test\/ipquality\/api\/scores(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Loon/IPQuality-Web/JS/IPQuality-Web-Module.js, tag=IP 检测接口 · 风险评分, timeout=65, requires-body=false, argument="scores", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/factors(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Loon/IPQuality-Web/JS/IPQuality-Web-Module.js, tag=IP 检测接口 · 风险因素, timeout=65, requires-body=false, argument="factors", enable=true
