http-request ^http:\/\/paperclip\.test\/ipquality\/api\/media(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Loon/IPQuality-Web/JS/IPQuality-Web-Module.js, tag=IP 检测接口 · 流媒体与 AI, timeout=65, requires-body=false, argument="media", enable=true
http-request ^http:\/\/paperclip\.test\/ipquality\/api\/regions(?:\?.*)?$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Loon/IPQuality-Web/JS/IPQuality-Web-Module.js, tag=IP 检测接口 · 地区一致性, timeout=65, requires-body=false, argument="regions", enable=true
