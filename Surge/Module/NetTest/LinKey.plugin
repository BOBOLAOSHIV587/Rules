#!name=LinKey Tool
#!desc=SPing: https://🍉.eu.org/ping \nJS引擎测试: https://🍉.eu.org/netms
#!date=2026-08-13
#!category=🐹 BOBO面板模块
#!author= Key[https://github.com/Keywos/rule]

[Rewrite]
^https?:\/\/.*\.linkey\.com\/?$ - reject

[Script]
http-request ^https?:\/\/.*\.linkey\.com\/api\/ping\/binary script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Surge/Module/NetTest/JS/ntbm.js, requires-body=true, binary-body-mode=true, timeout=50, tag=binary_test, max-size=2000000000

http-request ^https?:\/\/.*\.linkey\.com\/api\/test script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Surge/Module/NetTest/JS/nt.js, requires-body=true, timeout=300, tag=crypto_test,max-size=2000000000

http-request ^https?:\/\/.*\.linkey\.com\/api\/ping\? script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Surge/Module/NetTest/JS/api_ping.js, requires-body=true, timeout=200, tag=SPing,max-size=2000000000

http-request ^https?:\/\/.*\.linkey\.com\/api\/fetch\?url= script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Surge/Module/NetTest/JS/Sfetch.js, requires-body=true, timeout=300, tag=Sfetch,max-size=2000000000

[MITM]
hostname = *.linkey.com
