#!name= LinKey Tool
#!desc=  SPing: https://🍉.eu.org/ping \nJS引擎测试: https://🍉.eu.org/netms
#!date=2026-08-13
#!category=🐹 BOBO面板模块
#!author= Key[https://github.com/Keywos/rule]

[URL Rewrite]
^https?:\/\/.*\.linkey\.com\/?$ - reject

[Script]
binary_test = type=http-request, pattern=^https?:\/\/.*\.linkey\.com\/api\/ping\/binary, requires-body=1, timeout=50, binary-body-mode=1, max-size=2000000000, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Surge/Module/NetTest/JS/ntbm.js

crypto_test = type=http-request, pattern=^https?:\/\/.*\.linkey\.com\/api\/test, requires-body=1, timeout=300, max-size=2000000000, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Surge/Module/NetTest/JS/nt.js

SPing = type=http-request, pattern=^https?:\/\/.*\.linkey\.com\/api\/ping\?, requires-body=1, timeout=200, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Surge/Module/NetTest/JS/api_ping.js

Sfetch = type=http-request, pattern=^https?:\/\/.*\.linkey\.com\/api\/fetch\?url=, requires-body=1, timeout=300, max-size=2000000000, script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Surge/Module/NetTest/JS/Sfetch.js

[MITM]
hostname = %APPEND% *.linkey.com
